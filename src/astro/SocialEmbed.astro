---
const { node } = Astro.props;
const url = (node?.url as string | undefined)?.trim();

interface OEmbedRouteResult {
	html?: string;
	scriptSrc?: string | null;
	platform?: string;
	error?: string;
	needsCredentials?: boolean;
}

let embed: { html: string; scriptSrc: string | null; platform: string } | null = null;
let needsCredentials = false;

if (url) {
	try {
		// Call the plugin's own /oembed route — it reads Meta credentials from KV
		// so they never need to be hardcoded or set as env vars.
		const apiUrl = new URL(
			`/_emdash/api/plugins/social-embed/oembed?url=${encodeURIComponent(url)}`,
			Astro.url,
		);
		const res = await fetch(apiUrl.toString());
		if (res.ok) {
			// Emdash wraps all plugin route responses in { data: ... }
			const json = (await res.json()) as { data?: OEmbedRouteResult } | OEmbedRouteResult;
			const data = (json as { data?: OEmbedRouteResult }).data ?? (json as OEmbedRouteResult);
			if (data.html) {
				embed = {
					html: data.html,
					scriptSrc: data.scriptSrc ?? null,
					platform: data.platform ?? "",
				};
			} else if (data.needsCredentials) {
				needsCredentials = true;
			}
		}
	} catch {
		// Network error — silently degrade to link fallback
	}
}
---

{embed ? (
	<div class="social-embed" data-platform={embed.platform}>
		{/* set:html renders the oEmbed markup (iframe or blockquote).
		    Scripts are stripped from oEmbed HTML — innerHTML-injected scripts
		    don't execute in browsers. The platform script is a real DOM element
		    added below so it actually runs. Only present on pages with that embed type. */}
		<div set:html={embed.html} />
		{embed.scriptSrc && (
			<script define:vars={{ scriptSrc: embed.scriptSrc }}>
				if (!document.querySelector('script[data-social-embed-src="' + scriptSrc + '"]')) {
					var s = document.createElement("script");
					s.src = scriptSrc;
					s.async = true;
					s.setAttribute("data-social-embed-src", scriptSrc);
					document.head.appendChild(s);
				}
			</script>
		)}
	</div>
) : url ? (
	<div class="social-embed social-embed--fallback">
		<a href={url} target="_blank" rel="noopener noreferrer">{url}</a>
		{needsCredentials && (
			<p class="social-embed__note">
				Facebook and Threads embeds require Meta credentials — add them under{" "}
				<em>Social Embed</em> in the EmDash admin settings.
			</p>
		)}
	</div>
) : null}

<style>
	.social-embed {
		margin: 1.5rem auto;
		max-width: 550px;
	}

	.social-embed :global(iframe) {
		width: 100%;
		border: none;
		border-radius: 4px;
	}

	.social-embed--fallback a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 3px;
		word-break: break-all;
	}

	.social-embed__note {
		margin-top: 0.5rem;
		font-size: 0.8rem;
		color: #888;
	}
</style>
