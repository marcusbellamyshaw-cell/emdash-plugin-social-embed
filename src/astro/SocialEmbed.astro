---
const { node } = Astro.props;
const url = (node?.url as string | undefined)?.trim();

interface OEmbedRouteResult {
	html?: string;
	scriptSrc?: string | null;
	platform?: string;
	error?: string;
}

let embed: { html: string; scriptSrc: string | null; platform: string } | null = null;

if (url) {
	try {
		type InternalResult = { success: boolean; data?: OEmbedRouteResult };
		const internalHandler = (Astro.locals as Record<string, unknown>)
			?.emdash as { handlePublicPluginApiRoute?: (pluginId: string, method: string, path: string, req: Request) => Promise<InternalResult> } | undefined;

		if (internalHandler?.handlePublicPluginApiRoute) {
			const req = new Request(`https://x/oembed?url=${encodeURIComponent(url)}`);
			const result = await internalHandler.handlePublicPluginApiRoute("social-embed", "GET", "oembed", req);
			if (result.success && result.data?.html) {
				embed = {
					html: result.data.html,
					scriptSrc: result.data.scriptSrc ?? null,
					platform: result.data.platform ?? "",
				};
			}
		} else {
			const apiUrl = new URL(
				`/_emdash/api/plugins/social-embed/oembed?url=${encodeURIComponent(url)}`,
				Astro.url,
			);
			const res = await fetch(apiUrl.toString());
			if (res.ok) {
				const json = (await res.json()) as { data?: OEmbedRouteResult } | OEmbedRouteResult;
				const data = (json as { data?: OEmbedRouteResult }).data ?? (json as OEmbedRouteResult);
				if (data.html) {
					embed = { html: data.html, scriptSrc: data.scriptSrc ?? null, platform: data.platform ?? "" };
				}
			}
		}
	} catch (e) {
		console.error("[social-embed] embed failed:", e);
	}
}
---

{/* Only YouTube and Vimeo return 16:9 landscape video iframes. Twitter, Spotify,
    and TikTok render at their natural size. */}
{embed ? (
	<div class="social-embed" data-platform={embed.platform}>
		{["youtube", "vimeo"].includes(embed.platform) ? (
			<div class="social-embed__ratio">
				<div set:html={embed.html} />
			</div>
		) : (
			<div class="social-embed__natural">
				<div set:html={embed.html} />
			</div>
		)}
		{embed.scriptSrc && (
			<script define:vars={{ scriptSrc: embed.scriptSrc }}>
				if (!document.querySelector('script[data-social-embed-src="' + scriptSrc + '"]')) {
					var s = document.createElement("script");
					s.src = scriptSrc;
					s.async = true;
					s.setAttribute("data-social-embed-src", scriptSrc);
					document.head.appendChild(s);
				}
			</script>
		)}
	</div>
) : url ? (
	<div class="social-embed social-embed--fallback">
		<a href={url} target="_blank" rel="noopener noreferrer">{url}</a>
	</div>
) : null}

<style>
	.social-embed {
		margin: 1.5rem auto;
		max-width: 550px;
	}

	.social-embed :global(iframe) {
		width: 100%;
		border: none;
		border-radius: 4px;
	}

	/* 16:9 ratio wrapper — YouTube and Vimeo only.
	   Padding-bottom overrides the hardcoded height attribute from oEmbed.
	   Works on iOS Safari 9+, all Android browsers. */
	.social-embed__ratio {
		position: relative;
		padding-bottom: 56.25%;
		height: 0;
		overflow: hidden;
	}

	.social-embed__ratio :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.social-embed--fallback a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 3px;
		word-break: break-all;
	}
</style>
